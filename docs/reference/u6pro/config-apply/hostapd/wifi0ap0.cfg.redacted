interface=wifi0ap0
ctrl_interface=/var/run/hostapd
hw_mode=g
driver=nl80211
nas_identifier=$bssid
ssid=EXN IOT
wpa_group_rekey=0
wpa_group_update_count=4
wpa_gmk_rekey=0
beacon_prot=0
wpa_passphrase=***REDACTED***
accept_mac_file=/etc/hostapd/wifi0ap0.accept
vlan_tagged_interface=eth0
vlan_naming=1
vlan_bridge=br0.
vlan_file=/etc/hostapd/wifi0ap0.vlan
wpa=2
eapol_version=2
wpa_pairwise=CCMP
wpa_key_mgmt=WPA-PSK
logger_syslog=-1
logger_syslog_level=2
wlan_id=87ff
iapp_key=***REDACTED***
dpi_port=10101
dpi_ip=192.168.1.1
own_ip_addr=192.168.1.32
ht_capab=[LDPC][SMPS-DYNAMIC][TX-STBC][RX-STBC-1][MAX-AMSDU-7935][DSSS_CCK-40][HT20][SHORT-GI-20]
vht_capab=[MAX-MPDU-11454][RXLDPC][TX-STBC-2BY1][RX-STBC1][SU-BEAMFORMER][SOUNDING-DIMENSION-2][SU-BEAMFORMEE][BF-ANTENNA-4][MAX-A-MPDU-LEN-EXP7][RX-ANTENNA-PATTERN][TX-ANTENNA-PATTERN]
ieee80211n=1
ieee80211ac=1
ieee80211ax=1
channel=13
