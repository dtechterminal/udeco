diff --color -ruN a/mt76x3/common/ft_udft.c b/mt76x3/common/ft_udft.c
--- a/mt76x3/common/ft_udft.c	1970-01-01 05:30:00
+++ b/mt76x3/common/ft_udft.c	2026-11-23 00:14:33
@@ -0,0 +1,349 @@
+/*
+	drv2g: FT key interface for the udeco agent (UDFT) and local FT-PSK
+	R0/R1 generation (hostapd ft_psk_generate_local semantics).
+
+	The layouts and OIDs are in include/ft_udft.h; the protocol is in
+	udeco docs/deco/features/garage-ft.md.
+*/
+#include "rt_config.h"
+
+#ifdef DOT11R_FT_SUPPORT
+#include "ft.h"
+#include <linux/capability.h>
+#include <linux/sched.h>
+
+static UCHAR UDFT_DEF_AKM[4] = {0x00, 0x0F, 0xAC, 0x09};
+static UCHAR UDFT_DEF_PAIRWISE[4] = {0x00, 0x0F, 0xAC, 0x04};
+
+VOID FT_UDFT_Init(RTMP_ADAPTER *pAd)
+{
+	UDFT_CTRL *c = &pAd->ApCfg.FtTab.Udft;
+
+	if (c->ready)
+		return;
+	NdisZeroMemory(c, sizeof(*c));
+	NdisAllocateSpinLock(pAd, &c->lock);
+	c->ready = TRUE;
+}
+
+VOID FT_UDFT_Release(RTMP_ADAPTER *pAd)
+{
+	UDFT_CTRL *c = &pAd->ApCfg.FtTab.Udft;
+
+	if (!c->ready)
+		return;
+	c->ready = FALSE;
+	NdisFreeSpinLock(&c->lock);
+}
+
+BOOLEAN FT_UDFT_AkmIsFt(UINT8 *akm)
+{
+	if (akm == NULL)
+		return FALSE;
+	return (NdisEqualMemory(akm, OUI_FT_8021X_AKM, 4) ||
+		NdisEqualMemory(akm, OUI_FT_PSK_AKM, 4) ||
+		NdisEqualMemory(akm, OUI_FT_SAE_AKM, 4));
+}
+
+VOID FT_UDFT_EventPush(RTMP_ADAPTER *pAd, UINT8 type, UINT8 apidx,
+	UINT8 *sta, UINT8 *bssid, UINT8 *r0kh, UINT8 r0kh_len,
+	UINT8 *r0name, UINT8 *r1name, UINT8 *akm)
+{
+	UDFT_CTRL *c = &pAd->ApCfg.FtTab.Udft;
+	UDFT_EVENT ev, *e;
+	PNET_DEV dev;
+
+	if (!c->ready)
+		return;
+	NdisZeroMemory(&ev, sizeof(ev));
+	ev.version = UDFT_VERSION;
+	ev.type = type;
+	ev.apidx = apidx;
+	if (sta)
+		NdisMoveMemory(ev.sta, sta, MAC_ADDR_LEN);
+	if (bssid)
+		NdisMoveMemory(ev.bssid, bssid, MAC_ADDR_LEN);
+	if (r0kh && r0kh_len > 0 && r0kh_len <= UDFT_R0KH_MAX) {
+		ev.r0kh_id_len = r0kh_len;
+		NdisMoveMemory(ev.r0kh_id, r0kh, r0kh_len);
+	}
+	if (r0name)
+		NdisMoveMemory(ev.pmk_r0_name, r0name, 16);
+	if (r1name)
+		NdisMoveMemory(ev.pmk_r1_name, r1name, 16);
+	if (akm)
+		NdisMoveMemory(ev.akm, akm, 4);
+
+	RTMP_SEM_LOCK(&c->lock);
+	/* a miss already queued for the same key is not queued again */
+	if (type == UDFT_EVT_R1_MISS) {
+		UINT32 i;
+		for (i = 0; i < c->count; i++) {
+			e = &c->ring[(c->head + i) % UDFT_EVENT_RING];
+			if (e->type == UDFT_EVT_R1_MISS &&
+				NdisEqualMemory(e->pmk_r1_name, ev.pmk_r1_name, 16)) {
+				RTMP_SEM_UNLOCK(&c->lock);
+				goto notify;
+			}
+		}
+	}
+	ev.seq = ++c->seq;
+	if (c->count == UDFT_EVENT_RING) {
+		/* full: the oldest goes (the seq gap shows it) */
+		c->head = (c->head + 1) % UDFT_EVENT_RING;
+		c->count--;
+	}
+	NdisMoveMemory(&c->ring[(c->head + c->count) % UDFT_EVENT_RING], &ev, sizeof(ev));
+	c->count++;
+	RTMP_SEM_UNLOCK(&c->lock);
+
+notify:
+	/*
+		Wake-up for a listener: a wireless-extensions IWEVCUSTOM event
+		(RTM_NEWLINK) on the BSS interface, flags = OID_UDFT_EVENT_GET,
+		with the record as data. The record stays queued for the OID.
+	*/
+	dev = (apidx < MAX_MBSSID_NUM(pAd)) ? pAd->ApCfg.MBSSID[apidx].wdev.if_dev : NULL;
+	if (dev)
+		RtmpOSWrielessEventSend(dev, RT_WLAN_EVENT_CUSTOM, OID_UDFT_EVENT_GET,
+					NULL, (PUCHAR)&ev, sizeof(ev));
+}
+
+/* the BSS of this radio whose BSSID is bssid, FT on; -1 if none */
+static INT udft_bss(RTMP_ADAPTER *pAd, UINT8 *bssid)
+{
+	INT i;
+
+	for (i = 0; i < pAd->ApCfg.BssidNum && i < MAX_MBSSID_NUM(pAd); i++) {
+		if (MAC_ADDR_EQUAL(pAd->ApCfg.MBSSID[i].wdev.bssid, bssid) &&
+			pAd->ApCfg.MBSSID[i].FtCfg.FtCapFlag.Dot11rFtEnable)
+			return i;
+	}
+	return -1;
+}
+
+INT FT_UDFT_SetR1(RTMP_ADAPTER *pAd, RTMP_IOCTL_INPUT_STRUCT *wrq)
+{
+	UDFT_R1 *r = NULL;
+	UINT8 name[16];
+	UINT32 life;
+	INT bss, ret = 0;
+
+	if (!capable(CAP_NET_ADMIN))
+		return -EPERM;
+	if (wrq->u.data.length < sizeof(UDFT_R1))
+		return -EINVAL;
+	os_alloc_mem(pAd, (UCHAR **)&r, sizeof(UDFT_R1));
+	if (r == NULL)
+		return -ENOMEM;
+	if (copy_from_user(r, wrq->u.data.pointer, sizeof(UDFT_R1))) {
+		ret = -EFAULT;
+		goto out;
+	}
+	if (r->version != UDFT_VERSION || r->r0kh_id_len == 0 ||
+		r->r0kh_id_len > UDFT_R0KH_MAX) {
+		ret = -EINVAL;
+		goto out;
+	}
+	bss = udft_bss(pAd, r->r1kh_id);
+	if (bss < 0) {
+		ret = -ENODEV;
+		goto out;
+	}
+	FT_DerivePMKR1Name(r->pmk_r0_name, r->r1kh_id, r->sta, name);
+	if ((r->flags & 1) && !NdisEqualMemory(name, r->pmk_r1_name, 16)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	life = r->lifetime_s ? r->lifetime_s :
+		(pAd->ApCfg.MBSSID[bss].PMKCachePeriod / OS_HZ);
+	if (FT_R1khEntryInsert(pAd, r->pmk_r0_name, name, r->pmk_r1,
+			NdisEqualMemory(r->pairwise, ZERO_MAC_ADDR, 4) ? UDFT_DEF_PAIRWISE : r->pairwise,
+			NdisEqualMemory(r->akm, ZERO_MAC_ADDR, 4) ? UDFT_DEF_AKM : r->akm,
+			life, FT_REASSOC_DEADLINE, r->r0kh_id, r->r0kh_id_len, r->sta) != 0)
+		ret = -ENOMEM;
+	DBGPRINT(RT_DEBUG_TRACE, ("%s: R1 for %02x:%02x:%02x:%02x:%02x:%02x on ra%d: %d\n",
+		__FUNCTION__, PRINT_MAC(r->sta), bss, ret));
+out:
+	NdisZeroMemory(r, sizeof(UDFT_R1));
+	os_free_mem(pAd, r);
+	return ret;
+}
+
+INT FT_UDFT_GetEvents(RTMP_ADAPTER *pAd, RTMP_IOCTL_INPUT_STRUCT *wrq)
+{
+	UDFT_CTRL *c = &pAd->ApCfg.FtTab.Udft;
+	UDFT_EVENT *buf = NULL;
+	UINT32 want, n = 0;
+	INT ret = 0;
+
+	if (!capable(CAP_NET_ADMIN))
+		return -EPERM;
+	want = wrq->u.data.length / sizeof(UDFT_EVENT);
+	if (want > UDFT_EVENT_RING)
+		want = UDFT_EVENT_RING;
+	if (!c->ready || want == 0) {
+		wrq->u.data.length = 0;
+		return c->ready ? -EINVAL : -ENODEV;
+	}
+	os_alloc_mem(pAd, (UCHAR **)&buf, want * sizeof(UDFT_EVENT));
+	if (buf == NULL)
+		return -ENOMEM;
+	RTMP_SEM_LOCK(&c->lock);
+	while (n < want && c->count > 0) {
+		NdisMoveMemory(&buf[n++], &c->ring[c->head], sizeof(UDFT_EVENT));
+		c->head = (c->head + 1) % UDFT_EVENT_RING;
+		c->count--;
+	}
+	RTMP_SEM_UNLOCK(&c->lock);
+	wrq->u.data.length = n * sizeof(UDFT_EVENT);
+	if (n && copy_to_user(wrq->u.data.pointer, buf, wrq->u.data.length))
+		ret = -EFAULT;
+	os_free_mem(pAd, buf);
+	return ret;
+}
+
+INT FT_UDFT_GetR1(RTMP_ADAPTER *pAd, RTMP_IOCTL_INPUT_STRUCT *wrq)
+{
+	UDFT_R1_REQ req;
+	UDFT_R1 *r = NULL;
+	PAP_BSSID_INFO pk;
+	PFT_R1HK_ENTRY own;
+	UINT8 ownname[16];
+	ULONG now, alive;
+	INT bss, idx, ret = 0;
+
+	if (!capable(CAP_NET_ADMIN))
+		return -EPERM;
+	if (wrq->u.data.length < sizeof(UDFT_R1))
+		return -EINVAL;
+	if (copy_from_user(&req, wrq->u.data.pointer, sizeof(req)))
+		return -EFAULT;
+	if (req.version != UDFT_VERSION)
+		return -EINVAL;
+
+	/* the R0 is in the PMKID cache of the BSS the station associated to */
+	for (bss = 0; bss < pAd->ApCfg.BssidNum && bss < MAX_MBSSID_NUM(pAd); bss++) {
+		if (!pAd->ApCfg.MBSSID[bss].FtCfg.FtCapFlag.Dot11rFtEnable)
+			continue;
+		idx = RTMPSearchPMKIDCache(pAd, bss, req.sta);
+		if (idx < 0)
+			continue;
+		pk = &pAd->ApCfg.MBSSID[bss].PMKIDCache.BSSIDInfo[idx];
+		if (NdisEqualMemory(pk->PMKID, req.pmk_r0_name, 16))
+			break;
+	}
+	if (bss >= pAd->ApCfg.BssidNum || bss >= MAX_MBSSID_NUM(pAd))
+		return -ENOENT;
+
+	os_alloc_mem(pAd, (UCHAR **)&r, sizeof(UDFT_R1));
+	if (r == NULL)
+		return -ENOMEM;
+	NdisZeroMemory(r, sizeof(UDFT_R1));
+	r->version = UDFT_VERSION;
+	r->flags = 1;
+	NdisMoveMemory(r->sta, req.sta, MAC_ADDR_LEN);
+	NdisMoveMemory(r->r1kh_id, req.r1kh_id, MAC_ADDR_LEN);
+	r->r0kh_id_len = pAd->ApCfg.MBSSID[bss].FtCfg.FtR0khIdLen;
+	NdisMoveMemory(r->r0kh_id, pAd->ApCfg.MBSSID[bss].FtCfg.FtR0khId, r->r0kh_id_len);
+	NdisMoveMemory(r->pmk_r0_name, pk->PMKID, 16);
+	FT_DerivePMKR1(pk->PMK, pk->PMKID, req.r1kh_id, req.sta, r->pmk_r1, r->pmk_r1_name);
+
+	/* AKM and cipher of the initial association (our own R1's entry) */
+	FT_DerivePMKR1Name(pk->PMKID, pAd->ApCfg.MBSSID[bss].wdev.bssid, req.sta, ownname);
+	own = FT_R1khEntryTabLookup(pAd, ownname);
+	if (own) {
+		NdisMoveMemory(r->akm, own->AkmSuite, 4);
+		NdisMoveMemory(r->pairwise, own->PairwisChipher, 4);
+	}
+	NdisGetSystemUpTime(&now);
+	alive = now - pk->RefreshTime;
+	if (alive < pAd->ApCfg.MBSSID[bss].PMKCachePeriod)
+		r->lifetime_s = (pAd->ApCfg.MBSSID[bss].PMKCachePeriod - alive) / OS_HZ;
+
+	wrq->u.data.length = sizeof(UDFT_R1);
+	if (copy_to_user(wrq->u.data.pointer, r, sizeof(UDFT_R1)))
+		ret = -EFAULT;
+	NdisZeroMemory(r, sizeof(UDFT_R1));
+	os_free_mem(pAd, r);
+	return ret;
+}
+
+/*
+	An FT authentication whose PMKR1Name is not in the R1KH table.
+	FT-PSK: derive R0 and R1 here from the BSS's PSK, with the R0KH-ID the
+	station sent (hostapd ft_psk_generate_local=1), and check the R0 name
+	against the PMKID the station sent.
+	FT-SAE / FT-1X: queue a UDFT_EVT_R1_MISS for the agent and drop the
+	request silently (mac80211 sends 3 tries 200 ms apart) up
+	to UDFT_MISS_SILENT times; then answer status 28 (R0KH unreachable).
+	Returns the new entry, or NULL with *pStatus set.
+*/
+PFT_R1HK_ENTRY FT_UDFT_R1Miss(
+	IN PRTMP_ADAPTER pAd,
+	IN PMAC_TABLE_ENTRY pEntry,
+	IN PFT_CFG pFtCfg,
+	IN PFT_INFO pFtInfo_in,
+	IN PUINT8 pPmkR0Name,
+	OUT UINT16 *pStatus)
+{
+	UINT8 apidx = pEntry->func_tb_idx;
+	BSS_STRUCT *pMbss = &pAd->ApCfg.MBSSID[apidx];
+	struct wifi_dev *wdev = &pMbss->wdev;
+	PUINT8 pAkm, pCipher;
+	UINT8 count = 0;
+	UINT8 r0[LEN_PMK], r0name[16], r1[LEN_PMK], r1name[16];
+	UINT8 *r0kh = pFtInfo_in->FtIeInfo.R0khId;
+	UINT8 r0khlen = pFtInfo_in->FtIeInfo.R0khIdLen;
+
+	pAkm = WPA_ExtractSuiteFromRSNIE(pFtInfo_in->RSN_IE, pFtInfo_in->RSNIE_Len, AKM_SUITE, &count);
+	pCipher = WPA_ExtractSuiteFromRSNIE(pFtInfo_in->RSN_IE, pFtInfo_in->RSNIE_Len, PAIRWISE_SUITE, &count);
+	if (pAkm == NULL || pCipher == NULL || !FT_UDFT_AkmIsFt(pAkm)) {
+		*pStatus = MLME_INVALID_AKMP;
+		return NULL;
+	}
+	if (r0khlen == 0 || r0khlen > FT_ROKH_ID_LEN) {
+		*pStatus = FT_STATUS_CODE_INVALID_FTIE;
+		return NULL;
+	}
+
+	if (NdisEqualMemory(pAkm, OUI_FT_PSK_AKM, 4)) {
+		if (wdev->AuthMode != Ndis802_11AuthModeWPA2PSK &&
+			wdev->AuthMode != Ndis802_11AuthModeWPA1PSKWPA2PSK
+#ifdef DOT11_SAE_SUPPORT
+			&& wdev->AuthMode != Ndis802_11AuthModeWPA2PSKWPA3PSK
+#endif
+			) {
+			*pStatus = MLME_INVALID_AKMP;
+			return NULL;
+		}
+		FT_DerivePMKR0(pMbss->PMK, LEN_PMK, (PUINT8)pMbss->Ssid, pMbss->SsidLen,
+			pFtCfg->FtMdId, r0kh, r0khlen, pEntry->Addr, r0, r0name);
+		if (!NdisEqualMemory(r0name, pPmkR0Name, LEN_PMK_NAME)) {
+			/* another PSK, SSID or mobility domain at the R0KH */
+			NdisZeroMemory(r0, sizeof(r0));
+			*pStatus = FT_STATUS_CODE_INVALID_PMKID;
+			return NULL;
+		}
+		FT_DerivePMKR1(r0, r0name, wdev->bssid, pEntry->Addr, r1, r1name);
+		NdisZeroMemory(r0, sizeof(r0));
+		FT_R1khEntryInsert(pAd, r0name, r1name, r1, pCipher, pAkm,
+			pMbss->PMKCachePeriod / OS_HZ, FT_REASSOC_DEADLINE,
+			r0kh, r0khlen, pEntry->Addr);
+		NdisZeroMemory(r1, sizeof(r1));
+		*pStatus = MLME_SUCCESS;
+		return FT_R1khEntryTabLookup(pAd, r1name);
+	}
+
+	if (pEntry->FT_R1kh_CacheMiss_Times < UDFT_MISS_SILENT) {
+		pEntry->FT_R1kh_CacheMiss_Times++;
+		FT_UDFT_EventPush(pAd, UDFT_EVT_R1_MISS, apidx, pEntry->Addr, wdev->bssid,
+			r0kh, r0khlen, pPmkR0Name, pEntry->FT_PMK_R1_NAME, pAkm);
+		*pStatus = MLME_FAIL_NO_RESOURCE;
+		return NULL;
+	}
+	pEntry->FT_R1kh_CacheMiss_Times = 0;
+	*pStatus = FT_STATUS_CODE_R0KH_UNREACHABLE;
+	return NULL;
+}
+#endif /* DOT11R_FT_SUPPORT */
