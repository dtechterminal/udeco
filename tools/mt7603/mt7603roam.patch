diff --color -ruN a/mt76x3/common/cmm_cfg.c b/mt76x3/common/cmm_cfg.c
--- a/mt76x3/common/cmm_cfg.c	2026-11-23 15:55:21
+++ b/mt76x3/common/cmm_cfg.c	2026-11-23 00:05:47
@@ -1364,6 +1364,81 @@
                1.) iwpriv ra0 set site_survey
     ==========================================================================
 */
+#if defined(CONFIG_AP_SUPPORT) && defined(AP_SCAN_SUPPORT)
+/*
+	drv2g: the vendor mt7603eap's off-channel visit (Ghidra of its
+	Set_ApOffChanScan_Proc 0xb83bc and ApSiteSurveyNew_by_wdev 0x1fe14),
+	which the udeco agent's spectrum sweep drives
+	(internal/mtkwifi/offchan.go):
+	iwpriv raN set ApOffChanScan=<passive|active>:<channel>:<dwell ms>
+	The radio goes to the channel for one dwell (1..255 ms) and comes back
+	to its own channel, without restarting the AP. The kernel log gets
+	"ApSiteSurveyNew_by_wdev channel_index:<i> channel:<ch> time:<ms>" now
+	and "time_diff:<t> Busytime:<us> AvgNF:-95" at the dwell's end; the
+	busy time's score (100 - busy/4000) goes to OID 0x2014's slot <i>.
+	A channel off the list: EINVAL, no visit.
+*/
+static INT ApSiteSurveyNew_by_wdev(RTMP_ADAPTER *pAd, UCHAR channel, UCHAR timeout,
+	UCHAR ScanType, struct wifi_dev *wdev)
+{
+	MLME_SCAN_REQ_STRUCT ScanReq;
+	INT idx;
+
+	NdisZeroMemory(&ScanReq, sizeof(ScanReq));
+	AsicDisableSync(pAd);
+	BssTableInit(&pAd->ScanTab);
+	pAd->Mlme.ApSyncMachine.CurrState = AP_SYNC_IDLE;
+	ScanReq.BssType = BSS_ANY;
+	ScanReq.ScanType = ScanType;
+	pAd->ApCfg.bAutoChannelAtBootup = FALSE;
+	for (idx = 0; idx < pAd->ChannelListNum; idx++)
+		if (pAd->ChannelList[idx].Channel == channel)
+			break;
+	pAd->ApCfg.current_channel_index = (idx < pAd->ChannelListNum) ? idx : 0;
+	pAd->ScanCtrl.OffChChannel = channel;
+	pAd->ScanCtrl.OffChTime = timeout;
+	pAd->ScanCtrl.OffChStartNs = RtmpOsNowNs();
+	pAd->ScanCtrl.OffChState = OFFCH_START;
+	printk("%s channel_index:%d channel:%d time:%d\n", "ApSiteSurveyNew_by_wdev",
+		pAd->ApCfg.current_channel_index, channel, timeout);
+	MlmeEnqueue(pAd, AP_SYNC_STATE_MACHINE, APMT2_MLME_SCAN_REQ,
+		sizeof(MLME_SCAN_REQ_STRUCT), &ScanReq, (ULONG)wdev);
+	RTMP_MLME_HANDLER(pAd);
+	return TRUE;
+}
+
+INT Set_ApOffChanScan_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
+{
+	POS_COOKIE pObj = (POS_COOKIE) pAd->OS_Cookie;
+	struct wifi_dev *wdev;
+	RTMP_STRING *p1, *p2;
+	UCHAR type, channel;
+	LONG ms;
+
+	if (!RTMP_TEST_FLAG(pAd, fRTMP_ADAPTER_INTERRUPT_IN_USE))
+		return -ENETDOWN;
+	if (arg == NULL || (p1 = strchr(arg, ':')) == NULL || (p2 = strchr(p1 + 1, ':')) == NULL)
+		return FALSE;
+	*p1++ = '\0';
+	*p2++ = '\0';
+	if (strcmp(arg, "passive") == 0)
+		type = SCAN_PASSIVE;
+	else if (strcmp(arg, "active") == 0)
+		type = SCAN_ACTIVE;
+	else
+		return FALSE;
+	channel = (UCHAR)simple_strtol(p1, 0, 10);
+	ms = simple_strtol(p2, 0, 10);
+	if (channel == 0 || !ChannelSanity(pAd, channel) || ms < 1 || ms > 255)
+		return FALSE;
+	if (pObj->ioctl_if_type == INT_MBSSID && pObj->ioctl_if < pAd->ApCfg.BssidNum)
+		wdev = &pAd->ApCfg.MBSSID[pObj->ioctl_if].wdev;
+	else
+		wdev = &pAd->ApCfg.MBSSID[0].wdev;
+	return ApSiteSurveyNew_by_wdev(pAd, channel, (UCHAR)ms, type, wdev);
+}
+#endif /* CONFIG_AP_SUPPORT && AP_SCAN_SUPPORT */
