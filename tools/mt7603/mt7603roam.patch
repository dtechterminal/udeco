@@ -0,0 +1,90 @@
+/*
+	drv2g: the FT key interface between this driver and the udeco agent
+	("UDFT"). The agent moves PMK-R1 keys between this AP and the Decos'
+	hostapd over RRB (EtherType 0x890d); the driver only derives,
+	installs and reports keys. docs/deco/features/garage-ft.md in udeco
+	describes the protocol; the layouts here are its reference.
+
+	All three OIDs go through the RT_PRIV_IOCTL (0x8BE1) of the BSS
+	interface (ra0, ra1, ...): iwreq.u.data = {pointer, length, flags},
+	flags = OID, | 0x8000 (OID_GET_SET_TOGGLE) for the set. Multi-byte
+	integers are little-endian (the MIPS32el host's order). Every call
+	needs CAP_NET_ADMIN (the wext GET numbers have no check of their own).
+*/
+#ifndef __FT_UDFT_H__
+#define __FT_UDFT_H__
+
+#define OID_UDFT_R1_SET		0x0960	/* set (flags 0x8960): install one PMK-R1 */
+#define OID_UDFT_EVENT_GET	0x0961	/* query: dequeue key events */
+#define OID_UDFT_R1_GET		0x0962	/* query, in/out: derive a PMK-R1 for a peer R1KH */
+
+#define UDFT_VERSION		1
+#define UDFT_R0KH_MAX		48
+#define UDFT_EVENT_RING		32
+#define UDFT_MISS_SILENT	2	/* FT auth requests dropped (no reply) while the agent pulls; the next gets status 28 */
+
+/* event types */
+#define UDFT_EVT_R0_CREATED	1	/* initial FT-SAE/FT-1X association done here: R0 cached */
+#define UDFT_EVT_R1_MISS	2	/* FT auth with an unknown PMKR1Name: pull it */
+
+/* OID_UDFT_R1_SET in, OID_UDFT_R1_GET out: 140 bytes */
+typedef struct GNU_PACKED _UDFT_R1 {
+	UINT8 version;			/* UDFT_VERSION */
+	UINT8 r0kh_id_len;		/* 1..48 */
+	UINT8 flags;			/* bit 0: pmk_r1_name is given (else computed) */
+	UINT8 reserved;
+	UINT8 sta[6];			/* S1KH-ID = S0KH-ID */
+	UINT8 r1kh_id[6];		/* SET: one of this radio's BSSIDs; GET: the peer's */
+	UINT8 r0kh_id[UDFT_R0KH_MAX];
+	UINT8 pmk_r0_name[16];
+	UINT8 pmk_r1_name[16];
+	UINT8 pmk_r1[32];
+	UINT8 akm[4];			/* 00-0f-ac-xx; zero: 00-0f-ac-09 (FT-SAE) */
+	UINT8 pairwise[4];		/* zero: 00-0f-ac-04 (CCMP) */
+	UINT32 lifetime_s;		/* SET: 0 = the BSS's PMKCachePeriod; GET: remaining */
+} UDFT_R1;
+
+/* OID_UDFT_R1_GET in: 32 bytes (the same buffer returns a UDFT_R1) */
+typedef struct GNU_PACKED _UDFT_R1_REQ {
+	UINT8 version;
+	UINT8 reserved[3];
+	UINT8 sta[6];
+	UINT8 r1kh_id[6];		/* the peer AP that wants the key */
+	UINT8 pmk_r0_name[16];
+} UDFT_R1_REQ;
+
+/* OID_UDFT_EVENT_GET out: whole records, 104 bytes each */
+typedef struct GNU_PACKED _UDFT_EVENT {
+	UINT8 version;
+	UINT8 type;			/* UDFT_EVT_* */
+	UINT8 r0kh_id_len;
+	UINT8 apidx;			/* BSS index on this radio */
+	UINT8 sta[6];
+	UINT8 bssid[6];			/* our BSSID (the R1KH-ID of a miss) */
+	UINT8 r0kh_id[UDFT_R0KH_MAX];
+	UINT8 pmk_r0_name[16];
+	UINT8 pmk_r1_name[16];		/* R0_CREATED: our own R1's; R1_MISS: the wanted one */
+	UINT8 akm[4];
+	UINT32 seq;			/* +1 per event queued (gaps: events dropped) */
+} UDFT_EVENT;
+
+typedef struct _UDFT_CTRL {
+	BOOLEAN ready;
+	NDIS_SPIN_LOCK lock;
+	UINT32 seq;
+	UINT32 head, count;
+	UDFT_EVENT ring[UDFT_EVENT_RING];
+} UDFT_CTRL;
+
+struct _RTMP_ADAPTER;
+VOID FT_UDFT_Init(struct _RTMP_ADAPTER *pAd);
+VOID FT_UDFT_Release(struct _RTMP_ADAPTER *pAd);
+VOID FT_UDFT_EventPush(struct _RTMP_ADAPTER *pAd, UINT8 type, UINT8 apidx,
+	UINT8 *sta, UINT8 *bssid, UINT8 *r0kh, UINT8 r0kh_len,
+	UINT8 *r0name, UINT8 *r1name, UINT8 *akm);
+BOOLEAN FT_UDFT_AkmIsFt(UINT8 *akm);
+INT FT_UDFT_SetR1(struct _RTMP_ADAPTER *pAd, RTMP_IOCTL_INPUT_STRUCT *wrq);
+INT FT_UDFT_GetEvents(struct _RTMP_ADAPTER *pAd, RTMP_IOCTL_INPUT_STRUCT *wrq);
+INT FT_UDFT_GetR1(struct _RTMP_ADAPTER *pAd, RTMP_IOCTL_INPUT_STRUCT *wrq);
+
+#endif /* __FT_UDFT_H__ */
