+			PRINT_MAC(pRrm->NrStatic[i].Bssid), pRrm->NrStatic[i].BssidInfo,
+			pRrm->NrStatic[i].RegClass, pRrm->NrStatic[i].Channel, pRrm->NrStatic[i].PhyType);
+	return TRUE;
+}
