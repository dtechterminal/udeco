+/*
+	drv2g: iwpriv raN set BtmReq=<sta>,<bssid>,<channel>[,<disassoc timer
+	TBTT>[,<validity TBTT>[,<request-mode hex>]]]
+	One BSS Transition Management Request to one associated station with
+	one candidate. The candidate's operating class, PHY type and BSSID
+	Information come from the BSS's neighbour list (NrAdd) when it holds
+	the BSSID, else op class 81 (115 above channel 14), PHY 7 (HT),
+	reachable, same security. A disassociation timer > 0 sets
+	"disassociation imminent". The mode adds bits (0x02 abridged, 0x10
+	ESS disassociation imminent...); the preferred-candidate bit is set
+	by the driver. Needs WNMEnable=1 on the BSS and a station that
+	advertised BSS transition support; otherwise EINVAL.
+*/
+static INT drv2g_wnm_split(RTMP_STRING *s, RTMP_STRING **f, INT max)
+{
+	INT n = 0;
+
+	while (s && *s && n < max) {
+		f[n++] = s;
+		s = strchr(s, ',');
+		if (s)
+			*s++ = '\0';
+	}
+	return n;
+}
+
+INT Set_WNM_BtmReq_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
+{
+	POS_COOKIE pObj = (POS_COOKIE) pAd->OS_Cookie;
+	UCHAR ifIndex = pObj->ioctl_if;
+	RTMP_STRING *f[6];
+	UINT8 buf[sizeof(btm_reqinfo_t) + sizeof(struct nr_info)];
+	p_btm_reqinfo_t req = (p_btm_reqinfo_t)buf;
+	struct nr_info *c = req->candidates;
+	UINT32 info = 0x0000000f;	/* reachable, same security, same key scope */
+	INT n, i;
+	PMAC_TABLE_ENTRY pEntry;
+
+	if (ifIndex >= pAd->ApCfg.BssidNum || arg == NULL)
+		return FALSE;
+	if (!pAd->ApCfg.MBSSID[ifIndex].WNMCtrl.WNMBTMEnable)
+		return FALSE;
+	NdisZeroMemory(buf, sizeof(buf));
+	n = drv2g_wnm_split(arg, f, 6);
+	if (n < 3 || !rtstrmactohex(f[0], (RTMP_STRING *)req->sta_mac) ||
+		!rtstrmactohex(f[1], (RTMP_STRING *)c->bssid))
+		return FALSE;
+	pEntry = MacTableLookup(pAd, req->sta_mac);
+	if (pEntry == NULL || pEntry->func_tb_idx != ifIndex || !pEntry->BssTransitionManmtSupport)
+		return FALSE;
+	c->channum = (UINT8)simple_strtoul(f[2], NULL, 10);
+	if (c->channum == 0)
+		return FALSE;
+	if (n > 3)
+		req->disassoc_timer = (UINT16)simple_strtoul(f[3], NULL, 10);
+	req->valint = (n > 4) ? (UINT8)simple_strtoul(f[4], NULL, 10) : 200;
+	if (n > 5)
+		req->reqmode = (UINT8)simple_strtoul(f[5], NULL, 16);
+	req->timeout = 5;	/* s to wait for the response */
+	req->num_candidates = 1;
+
+	c->regclass = (c->channum > 14) ? 115 : 81;
+	c->phytype = 7;
+#ifdef DOT11K_RRM_SUPPORT
+	{
+		PRRM_CONFIG pRrm = &pAd->ApCfg.MBSSID[ifIndex].RrmCfg;
+
+		for (i = 0; i < pRrm->NrStaticNum; i++) {
+			if (MAC_ADDR_EQUAL(pRrm->NrStatic[i].Bssid, c->bssid)) {
+				info = pRrm->NrStatic[i].BssidInfo;
+				if (pRrm->NrStatic[i].RegClass)
+					c->regclass = pRrm->NrStatic[i].RegClass;
+				if (pRrm->NrStatic[i].PhyType)
+					c->phytype = pRrm->NrStatic[i].PhyType;
+				break;
+			}
+		}
+	}
+#endif /* DOT11K_RRM_SUPPORT */
+	/* BSSID Information bits back to the nr_info fields compose_btm_req_ie reads */
+	c->ap_reachability = info & 0x3;
+	c->security = (info >> 2) & 1;
+	c->key_scope = (info >> 3) & 1;
+	c->capinfo = ((info & (1 << 4)) ? (1 << 8) : 0) | ((info & (1 << 5)) ? (1 << 9) : 0) |
+		((info & (1 << 6)) ? (1 << 11) : 0) | ((info & (1 << 7)) ? RRM_CAP_BIT : 0) |
+		((info & (1 << 8)) ? (1 << 14) : 0) | ((info & (1 << 9)) ? (1 << 15) : 0);
+	c->mobility = (info >> 10) & 1;
+	c->is_ht = (info >> 11) & 1;
+	c->preference = 255;
+
+	return (send_btm_req_param(pAd, req, sizeof(buf)) == NDIS_STATUS_SUCCESS) ? TRUE : FALSE;
+}
