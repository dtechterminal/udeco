+/*
+	drv2g: the per-BSS neighbour list the udeco agent sets (802.11k
+	Neighbor Report answers; also the BTM candidates' defaults).
+	iwpriv raN set NrAdd=<bssid>,<bssid-info hex>,<op class>,<channel>,<phy type>
+	iwpriv raN set NrDel=<bssid>
+	iwpriv raN set NrClear=1
+	iwpriv raN show nrlist
+	NrAdd replaces an entry with the same BSSID; at most 16.
+*/
+static INT drv2g_split(RTMP_STRING *s, RTMP_STRING **f, INT max)
+{
+	INT n = 0;
+
+	while (s && *s && n < max) {
+		f[n++] = s;
+		s = strchr(s, ',');
+		if (s)
+			*s++ = '\0';
+	}
+	return n;
+}
+
+INT Set_RRM_NrAdd_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
+{
+	POS_COOKIE pObj = (POS_COOKIE) pAd->OS_Cookie;
+	UCHAR ifIndex = pObj->ioctl_if;
+	PRRM_CONFIG pRrm;
+	RTMP_STRING *f[5];
+	UINT8 mac[MAC_ADDR_LEN];
+	INT i;
+
+	if (ifIndex >= pAd->ApCfg.BssidNum || arg == NULL)
+		return FALSE;
+	pRrm = &pAd->ApCfg.MBSSID[ifIndex].RrmCfg;
+	if (drv2g_split(arg, f, 5) != 5 || !rtstrmactohex(f[0], (RTMP_STRING *)mac))
+		return FALSE;
+	for (i = 0; i < pRrm->NrStaticNum; i++)
+		if (MAC_ADDR_EQUAL(pRrm->NrStatic[i].Bssid, mac))
+			break;
+	if (i == pRrm->NrStaticNum) {
+		if (pRrm->NrStaticNum >= RRM_NR_STATIC_MAX)
+			return FALSE;
+		pRrm->NrStaticNum++;
+	}
+	COPY_MAC_ADDR(pRrm->NrStatic[i].Bssid, mac);
+	pRrm->NrStatic[i].BssidInfo = (UINT32)simple_strtoul(f[1], NULL, 16);
+	pRrm->NrStatic[i].RegClass = (UINT8)simple_strtoul(f[2], NULL, 10);
+	pRrm->NrStatic[i].Channel = (UINT8)simple_strtoul(f[3], NULL, 10);
+	pRrm->NrStatic[i].PhyType = (UINT8)simple_strtoul(f[4], NULL, 10);
+	return TRUE;
+}
+
+INT Set_RRM_NrDel_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
+{
+	POS_COOKIE pObj = (POS_COOKIE) pAd->OS_Cookie;
+	UCHAR ifIndex = pObj->ioctl_if;
+	PRRM_CONFIG pRrm;
+	UINT8 mac[MAC_ADDR_LEN];
+	INT i;
+
+	if (ifIndex >= pAd->ApCfg.BssidNum || arg == NULL || !rtstrmactohex(arg, (RTMP_STRING *)mac))
+		return FALSE;
+	pRrm = &pAd->ApCfg.MBSSID[ifIndex].RrmCfg;
+	for (i = 0; i < pRrm->NrStaticNum; i++) {
+		if (MAC_ADDR_EQUAL(pRrm->NrStatic[i].Bssid, mac)) {
+			pRrm->NrStaticNum--;
+			if (i != pRrm->NrStaticNum)
+				NdisMoveMemory(&pRrm->NrStatic[i], &pRrm->NrStatic[pRrm->NrStaticNum],
+					sizeof(RRM_NR_STATIC));
+			return TRUE;
+		}
+	}
+	return TRUE;
+}
+
+INT Set_RRM_NrClear_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
+{
+	POS_COOKIE pObj = (POS_COOKIE) pAd->OS_Cookie;
+	UCHAR ifIndex = pObj->ioctl_if;
+
+	if (ifIndex >= pAd->ApCfg.BssidNum)
+		return FALSE;
+	pAd->ApCfg.MBSSID[ifIndex].RrmCfg.NrStaticNum = 0;
+	return TRUE;
+}
+
+INT Show_RRM_NrList_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
+{
+	POS_COOKIE pObj = (POS_COOKIE) pAd->OS_Cookie;
